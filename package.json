{
  "name": "jessie-ouo-link",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --watch scripts/serve.ts",
    "preview": "bun scripts/serve.ts --production",
    "build": "bun scripts/build.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "bun --bun biome format --write .",
    "lint": "bun --bun biome lint .",
    "check": "bun --bun biome check .",
    "check:fix": "bun --bun biome check --write .",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "verify": "bun run check && bun run typecheck && bun run test && bun run build --preview",
    "test:browser": "bun scripts/browser-check.ts",
    "perf": "bun scripts/lighthouse.ts",
    "social": "bun scripts/social.ts",
    "deps:check": "bun --bun ncu --target latest",
    "deps:update": "bun --bun ncu --target latest -u && bun install",
    "deploy:check": "bun run verify && bun run build && bun --bun wrangler deploy --dry-run",
    "deploy": "bun run verify && bun run build && bun --bun wrangler deploy"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "npm-check-updates": "23.1.1",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
